# Supabase project URL and public anon key (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# Public base URL of the deployed app — used to build links in emails (View Ticket, invites, etc.)
NEXT_PUBLIC_APP_URL=https://ticketing-system.pengroup.com

# Supabase service role key — server-only, never expose to browser
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# Microsoft Entra ID tenant ID — used when configuring the Azure OAuth provider in
# the Supabase Auth dashboard (set as the Tenant URL, not "common", to restrict
# sign-ins to PEN organisation accounts only)
ENTRA_TENANT_ID=<your-microsoft-tenant-id>

# Prisma / Postgres connection strings
# Transaction pooler (port 6543) — runtime only. Never use db.*.supabase.co here.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&pool_timeout=30"
# Session pooler (port 5432) — Prisma migrate / db push via prisma.config.ts
# Prefer db.<project-ref>.supabase.co:5432 when reachable (true direct):
# DIRECT_URL="postgresql://postgres:[password]@db.<project-ref>.supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"
# Optional: node-pg Pool size per process (default 1). Must stay low — Supavisor
# caps ~400 *client* slots project-wide (EMAXCONN).
DB_POOL_MAX=1
# App code must use the singleton: import { prisma } from "@/lib/db"
# (or `@/lib/prisma`). Never `new PrismaClient()` in routes/actions.

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@yourorg.com

# Microsoft Clarity — project ID from clarity.microsoft.com (Get tracking code)
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# AI assist/compose features (ticket titles, descriptions, summaries, triage,
# support-intake chat) run on a shuffled pool of free providers with failover —
# see src/lib/ai.ts. At least one key must be set for AI features to work.

# Groq — https://console.groq.com/keys
GROQ_API_KEY=<your-groq-api-key>
# Optional: override the Groq model (default: openai/gpt-oss-20b).
# Must support structured outputs: https://console.groq.com/docs/structured-outputs#supported-models
# GROQ_MODEL=openai/gpt-oss-20b

# OpenRouter — https://openrouter.ai/keys (free models used, see src/lib/ai.ts)
OPENROUTER_API_KEY=<your-openrouter-api-key>

# Mailbox connection credentials at rest (NFR-03) — AES-256-GCM key for
# MailboxConnection.credentialsRef, see src/lib/mailbox-credentials.ts. Only
# needed once an OAuth/IMAP mailbox is configured (RESEND doesn't use it).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MAILBOX_CREDENTIALS_KEY=<32-random-bytes-base64-encoded>
