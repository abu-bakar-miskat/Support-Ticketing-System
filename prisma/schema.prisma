  mergedAt    DateTime?
  ghCreatedAt DateTime? // PR creation time reported by GitHub (distinct from row insert time)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tickets TicketPullRequest[]

  @@unique([repository, number])
}

model TicketPullRequest {
  ticketId String
  prId     String

  ticket Ticket            @relation(fields: [ticketId], references: [id])
  pr     GitHubPullRequest @relation(fields: [prId], references: [id])

  @@id([ticketId, prId])
  @@index([prId])
}

model GitHubCommit {
  id          String   @id @default(cuid())
  sha         String
  message     String
  url         String
  authorLogin String
  ticketId    String
  createdAt   DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id])

  @@unique([sha, ticketId]) // one commit message may reference several tickets
  @@index([ticketId])
}

// ── Recruitment boards (Notion-style candidate pipelines, manager+) ──────────

enum RecruitmentFieldType {
  text
  select
  multi_select
  number
  date
  url
  email
  phone
  rating
  checkbox
  file
}

model RecruitmentBoard {
  id          String    @id @default(cuid())
  name        String
  createdById String    @db.Uuid
  /** Department that owns this board. Recruitment is scoped per-department. */
  departmentId String?
  createdAt   DateTime  @default(now())
  /** Set when the board is moved to History (archived); null = active. */
  archivedAt  DateTime?

  department Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  fields     RecruitmentField[]
  candidates RecruitmentCandidate[]

  @@index([departmentId])
}

model RecruitmentField {
  id      String               @id @default(cuid())
  boardId String
  name    String
  type    RecruitmentFieldType @default(text)
  /** For select/multi_select: [{ id, label, color }] */
  options   Json?
  order     Int
  hidden    Boolean  @default(false)
  createdAt DateTime @default(now())

  board RecruitmentBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@index([boardId])
}

model RecruitmentCandidate {
  id      String @id @default(cuid())
  boardId String
  /** Cell values keyed by RecruitmentField id */
  values      Json     @default("{}")
  order       Int      @default(0)
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  board             RecruitmentBoard   @relation(fields: [boardId], references: [id], onDelete: Cascade)
  screeningSessions ScreeningSession[]

  @@index([boardId])
}

enum ScreeningStatus {
  sent
  started
  submitted
  scored
  expired
}

/// One async video screening invite. The token is the candidate's only
/// credential — these rows are never exposed through the Supabase anon key,
/// only via server routes.
model ScreeningSession {
  id            String          @id @default(cuid())
  candidateId   String?
  candidateName String
  email         String
  roleTitle     String
  token         String          @unique
  status        ScreeningStatus @default(sent)
  createdById   String?         @db.Uuid
  createdAt     DateTime        @default(now())
  expiresAt     DateTime
  startedAt     DateTime?
  submittedAt   DateTime?
  /** Mean of answer scores once scoring completes, 0–5. */
  overallScore  Float?
  /** Reviewer sign-off: set when a manager marks the screening complete. */
  completedAt   DateTime?
  completedById String?         @db.Uuid
  /** Resend email id of the invite, kept for delivery-status lookups. */
  resendEmailId String?
  /** Last Resend event (sent/delivered/opened/bounced/…), refreshed lazily. */
  emailStatus   String?
  /** When emailStatus was last refreshed from Resend — throttles lookups. */
  emailStatusAt DateTime?
  /** Last scoring attempt (initial or retry) — backs the stuck-scoring self-heal. */
  scoringAttemptAt DateTime?
  /** Reviewer integrity flag: a human's video-review verdict (e.g. reading answers off-screen). */
  reviewerFlaggedAt   DateTime?
  reviewerFlaggedById String?   @db.Uuid
  reviewerFlagNote    String?

  candidate RecruitmentCandidate? @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  answers   ScreeningAnswer[]

  @@index([candidateId])
  @@index([status])
}

/// Editable question bank for video screening. Sessions snapshot prompt/hint/
/// rubric onto their answers at invite time, so editing a question never
/// rewrites what an already-invited candidate was asked.
model ScreeningQuestion {
  id             String   @id @default(cuid())
  position       Int
  prompt         String
  hint           String   @default("")
  rubricFive     String   @default("")
  rubricThree    String   @default("")
  rubricOne      String   @default("")
  rubricPenalise String   @default("")
  active         Boolean  @default(true)
  /** Always in every invite (e.g. the location/hours question); others are drawn randomly. */
  alwaysInclude  Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ScreeningAnswer {
  id          String    @id @default(cuid())
  sessionId   String
  questionKey String
  position    Int
  /** Snapshot of the question as asked (survives later edits to the bank). */
  prompt      String?
  hint        String?
  /** Snapshot rubric: { five, three, one, penalise }. */
  rubric      Json?
  /** R2 object key of the recorded video; null until uploaded. */
  objectKey   String?
  durationSec Int?
  takesUsed   Int       @default(0)
  transcript  String?
  score       Int?
  reasoning   String?
  /** Verbatim quote from the transcript backing the score. */
  evidence    String?
  flags       String[]  @default([])
  uploadedAt  DateTime?
  scoredAt    DateTime?
  /** Last transcription/scoring failure for this answer; cleared on success. */
  scoringError String?
  /** How many webcam frame sheets were uploaded alongside the recording. */
  frameCount   Int       @default(0)
  /** AI gaze-check verdict (no_concern / possible_reading / likely_reading) — verify-on-video signal, never affects the score. */
  gazeVerdict   String?
  gazeReasoning String?

  session ScreeningSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, questionKey])
  @@index([sessionId])
}
