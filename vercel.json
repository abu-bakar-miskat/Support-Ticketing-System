{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["cdg1"],
  "git": {
    "deploymentEnabled": {
      "**": false,
      "dev": true,
      "main": true
    }
  },
  "crons": [
    {
      "path": "/api/cron/purge-raw-payloads",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/sla-check",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/availability-sweep",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/bulk-reassign-sweep",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/mailbox-health-check",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/report-export-sweep",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/agreement-reminder-sweep",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/scheduled-reports",
      "schedule": "0 * * * *"
    }
  ]
}
